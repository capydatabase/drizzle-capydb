{
  "name": "@capydb/drizzle",
  "version": "1.6.4",
  "description": "Official Drizzle ORM helpers for CapyDB - pooled-aware postgres-js clients with safe transaction-pooler defaults.",
  "keywords": [
    "capydb",
    "postgres",
    "database",
    "drizzle",
    "drizzle-orm",
    "postgres-js",
    "pgbouncer",
    "serverless"
  ],
  "homepage": "https://capydb.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/capydatabase/capydb-drizzle"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && cp dist/index.d.ts dist/index.d.cts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "format": "oxfmt --write src test",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm build",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; else echo 'no git repository - skipping lefthook install'; fi"
  },
  "peerDependencies": {
    "drizzle-orm": ">=1.0.0-rc.5 <2",
    "postgres": ">=3.4.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.5.0",
    "drizzle-orm": "rc5",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "postgres": "^3.4.9",
    "tsdown": "0.23.0",
    "typescript": "next",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
