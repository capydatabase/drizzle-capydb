{
  "name": "@capydb/drizzle",
  "version": "1.11.0",
  "description": "Official Drizzle ORM helpers for CapyDB - pooled-aware postgres-js clients with safe transaction-pooler defaults.",
  "keywords": [
    "capydb",
    "postgres",
    "database",
    "drizzle",
    "drizzle-orm",
    "postgres-js",
    "pgbouncer",
    "serverless"
  ],
  "homepage": "https://capydb.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capydatabase/drizzle-capydb.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && cp dist/index.d.ts dist/index.d.cts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "format": "oxfmt --write src test",
    "format:check": "oxfmt --check src test",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm build",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; else echo 'no git repository - skipping lefthook install'; fi"
  },
  "peerDependencies": {
    "drizzle-orm": ">=1.0.0-rc.5 <2",
    "postgres": ">=4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "drizzle-orm": "rc5",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "postgres": "^4.1.0",
    "tsdown": "0.23.7",
    "typescript": "next",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": ">=24.22.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
